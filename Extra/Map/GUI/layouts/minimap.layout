FrameWidgetClass MinimapRoot {
 ignorepointer 1
 clipchildren 0
 position 0 0
 size 1 1
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 0
 {
  MapWidgetClass MiniMap {
   visible 1
   ignorepointer 1
   position -24 -48
   size 200 200
   halign right_ref
   valign bottom_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   clipchildren 1
   scriptclass ""
   {
    CanvasWidgetClass CanvasMiniMap {
     visible 1
     ignorepointer 1
     position 0 0
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 1000
    }
   }
  }
 }
}
