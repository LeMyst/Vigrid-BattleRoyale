FrameWidgetClass MapMenuRoot {
 clipchildren 0
 position 0 0
 size 1 1
 halign center_ref
 valign center_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 priority 50
 {
  PanelWidgetClass Background {
   visible 1
   ignorepointer 1
   color 0 0 0 0.85
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
  }
  // Why the server refused a marker, shown for a few seconds. It sits in the strip ABOVE the map -
  // VigridMap starts at y 0.03 - so it is over the Background panel rather than over the terrain,
  // which is what makes it readable without a backdrop of its own. The shadow covers the case where
  // the strip is thinner than the text on an unusual aspect ratio.
  //
  // `inheritalpha 0` deliberately: a parent that is ever given an alpha would otherwise multiply
  // through and take the message with it, silently and with a clean log.
  TextWidgetClass MarkerToast {
   visible 0
   ignorepointer 1
   inheritalpha 0
   position 0 0
   size 1 0.03
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 2000
   color 1 0.85 0.4 1
   text ""
   font "gui/fonts/metron-bold22"
   "shadow size" 3
   "shadow color" 0 0 0 1
   "shadow offset" 1 1
   "exact text" 1
   "exact text size" 22
   "size to text h" 0
   "size to text v" 0
   "text halign" center
   "text valign" center
  }
  // NAMES FOR THE AdminCanvas GLYPHS, and it is a SIBLING of the MapWidget rather than a child of
  // it - which is the whole reason this can exist at all. A CanvasWidget draws lines and nothing
  // else, so there is no text on the map; and widgets CREATED FROM SCRIPT over a MapWidget get
  // correct positions and are then never rendered, measured repeatedly in this repo. A declared
  // sibling drawn above it by priority is the one construct left, and MarkerToast above is the
  // working precedent for text over this menu.
  //
  // Empty in the layout: VigridMapMenu pools map_admin_tag.layout rows into it and positions them
  // in REAL SCREEN PIXELS, so the geometry here is a full-screen frame and nothing more. clipchildren
  // 0 because rows are hidden by script when they fall outside the map rect, not clipped.
  FrameWidgetClass AdminNameLayer {
   visible 0
   clipchildren 0
   ignorepointer 1
   inheritalpha 0
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 2100
  }
  MapWidgetClass VigridMap {
   visible 1
   clipchildren 1
   inheritalpha 0
   position 0 0.03
   size 0.98 0.94
   halign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   scriptclass ""
   {
    CanvasWidgetClass ZoneCanvas {
     visible 1
     ignorepointer 1
     position 0 0
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 1000
    }
    CanvasWidgetClass MarkerCanvas {
     visible 1
     ignorepointer 1
     position 0 0
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 1001
    }
    CanvasWidgetClass LineCanvas {
     visible 1
     ignorepointer 1
     position 0 0
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 999
    }
    CanvasWidgetClass TeamCanvas {
     visible 1
     ignorepointer 1
     position 0 0
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 1002
    }
    // Players the host mod asked to be plotted - in practice an admin spectator's overview of the
    // whole match. Highest priority of the five, so a live player draws over every other glyph.
    CanvasWidgetClass AdminCanvas {
     visible 1
     ignorepointer 1
     position 0 0
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 1003
    }
   }
  }
 }
}
