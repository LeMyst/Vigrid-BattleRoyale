// One name label for a player plotted on the fullscreen map (host push, see VigridMapAPI).
//
// Pooled by VigridMapMenu into the AdminNameLayer frame - a SIBLING of the MapWidget, never a child
// of it: script-created widgets over a MapWidget are positioned correctly and then never rendered.
//
// EVERY NUMBER HERE IS A WORKBENCH PLACEHOLDER. The script positions and sizes each row in real
// screen pixels, and a widget's DECLARED geometry is scaled by viewport/1920 while SetPos/SetSize
// are not - so mixing the two shifts a whole group while its spacing stays correct, which reads as
// an angle bug rather than a coordinate one.
PanelWidgetClass AdminTagRoot {
 visible 0
 ignorepointer 1
 clipchildren 0
 color 0 0 0 0
 position 0 0
 size 120 16
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 {
  // The backdrop carries `style`, and it has to: a PanelWidget with a `color` and NO style paints
  // NOTHING - it still lays out and still hosts its children, so the text would draw perfectly over
  // a completely transparent background. Over satellite imagery that is unreadable half the time.
  // rover_sim_colorable is the plain tintable fill; DayZDefaultPanel's texture eats the alpha and
  // reads as a solid slab.
  PanelWidgetClass AdminTagBack {
   visible 1
   ignorepointer 1
   inheritalpha 1
   style rover_sim_colorable
   color 0 0 0 0.6
   position 0 0
   size 120 16
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   {
    // Tinted per row by the script to the player's team colour, so the label and its glyph agree.
    TextWidgetClass AdminTagName {
     visible 1
     ignorepointer 1
     inheritalpha 1
     color 1 1 1 1
     position 0 0
     size 120 16
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     font "gui/fonts/metron-bold12"
     "exact text" 1
     "exact text size" 12
     "size to text h" 0
     "size to text v" 0
     "text halign" center
     "text valign" center
     text ""
    }
   }
  }
 }
}
