PanelWidgetClass RowRoot {
 visible 1
 ignorepointer 1
 position 0 0
 size 256 64
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 color 0 0 0 0.4
 style DayZDefaultPanel
 {
  TextWidgetClass RowName {
   inheritalpha 1
   ignorepointer 1
   position 0 0
   size 1 0.36
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   scaled 1
   style Bold
   text "Survivor"
   font "gui/fonts/metron"
   "exact text" 0
   "text halign" left
   "text valign" center
  }
  // The icons hang directly off RowRoot rather than off a transparent container panel. A child's
  // alpha is multiplied by its parent's, so a wrapper with `color 0 0 0 0` renders every icon inside
  // it fully invisible - which is exactly what happened the first time round.
  ImageWidgetClass RowHealthIcon {
   visible 1
   ignorepointer 1
   inheritalpha 1
   position 2 25
   size 18 18
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 1 1 1 1
   // Only image0 can be declared here - the parser recognises no `image1`, and no vanilla layout
   // uses one. VigridPartyHud.LoadIconFrames() loads frames 1..4 from script at row creation,
   // because SetImage() switches only between slots that have actually been loaded.
   image0 "set:dayz_gui image:iconHealth0"
   mode blend
   "src alpha" 1
   "no wrap" 1
   stretch 1
  }
  ImageWidgetClass RowBloodIcon {
   visible 1
   ignorepointer 1
   inheritalpha 1
   position 26 25
   size 18 18
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 1 1 1 1
   image0 "set:dayz_gui image:iconBlood0"
   mode blend
   "src alpha" 1
   "no wrap" 1
   stretch 1
  }
  TextWidgetClass RowStatusText {
   inheritalpha 1
   ignorepointer 1
   position 0 0.36
   size 1 0.32
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   text ""
   font "gui/fonts/metron"
   "exact text" 0
   "size to text h" 0
   "size to text v" 0
   "text halign" left
   "text valign" center
  }
  TextWidgetClass RowDistanceText {
   inheritalpha 1
   ignorepointer 1
   position 0 0.68
   size 1 0.32
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   text "0m"
   font "gui/fonts/metron"
   "exact text" 0
   "size to text h" 0
   "size to text v" 0
   "text halign" left
   "text valign" center
  }
 }
}
