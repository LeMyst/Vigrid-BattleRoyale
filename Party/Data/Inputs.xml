<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<modded_inputs>
    <inputs>
        <actions>
            <!-- loc= takes a BARE stringtable key with no leading '#'. Keys live in this
                 addon's own stringtable.csv - Party must not reference a STR_BR_* key. -->
            <input name="UAVigridPartyMenu" loc="STR_PARTY_KEYBIND_MENU" />
            <input name="UAVigridPartyPing" loc="STR_PARTY_KEYBIND_PING" />
            <input name="UAVigridPartyPingClear" loc="STR_PARTY_KEYBIND_PINGCLEAR" />
        </actions>

        <sorting name="vigridparty" loc="STR_PARTY_KEYBIND_CATEGORY">
            <input name="UAVigridPartyMenu" />
            <input name="UAVigridPartyPing" />
            <input name="UAVigridPartyPingClear" />
        </sorting>
    </inputs>
    <preset>
        <input name="UAVigridPartyMenu">
            <btn name="kP" />
        </input>
        <input name="UAVigridPartyPing">
            <btn name="kT" />
        </input>
        <input name="UAVigridPartyPingClear">
            <btn name="kY" />
        </input>
    </preset>
</modded_inputs>
