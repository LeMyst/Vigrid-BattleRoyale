<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<modded_inputs>
    <inputs>
        <actions>
            <!-- loc= takes a BARE stringtable key with no leading '#' - that is the engine's
                 convention here, and it is what DayZ-Expansion's own Inputs.xml files use.
                 A raw English label renders untranslated in Options -> Controls. -->
            <input name="UADayZBRReadyUp" loc="STR_BR_KEYBIND_READYUP" />
            <input name="UADayZBRUnstuck" loc="STR_BR_KEYBIND_UNSTUCK" />
            <input name="UADayZBRLeaderboard" loc="STR_BR_KEYBIND_LEADERBOARD" />
            <input name="UADayZBRAdminSpectate" loc="STR_BR_KEYBIND_ADMINSPECTATE" />
            <input name="UADayZBRSpectateMode" loc="STR_BR_KEYBIND_SPECTATEMODE" />
            <input name="UADayZBRSpectateNext" loc="STR_BR_KEYBIND_SPECTATENEXT" />
            <input name="UADayZBRSpectatePrev" loc="STR_BR_KEYBIND_SPECTATEPREV" />
            <input name="UADayZBRSpectateSkeleton" loc="STR_BR_KEYBIND_SPECTATESKELETON" />
            <input name="UADayZBRSpectateView" loc="STR_BR_KEYBIND_SPECTATEVIEW" />
        </actions>

        <sorting name="dayzbr" loc="STR_BR_KEYBIND_CATEGORY">
            <input name="UADayZBRReadyUp" />
            <input name="UADayZBRUnstuck" />
            <input name="UADayZBRLeaderboard" />
            <input name="UADayZBRAdminSpectate" />
            <input name="UADayZBRSpectateMode" />
            <input name="UADayZBRSpectateNext" />
            <input name="UADayZBRSpectatePrev" />
            <input name="UADayZBRSpectateSkeleton" />
            <input name="UADayZBRSpectateView" />
        </sorting>
    </inputs>
    <preset>
        <input name="UADayZBRReadyUp">
            <btn name="kF1" />
        </input>
        <input name="UADayZBRUnstuck">
            <btn name="kF2" />
        </input>
        <input name="UADayZBRLeaderboard">
            <btn name="kF4" />
        </input>
        <!-- Admin spectate. F3 is the only free function key below F4; F1/F2/F4 are taken above.
             The arrows are unbound in vanilla gameplay, and a spectator has no use for them
             otherwise. All four are refused server-side for anyone not in admins_steamid64, so a
             non-admin pressing them gets nothing. -->
        <input name="UADayZBRAdminSpectate">
            <btn name="kF3" />
        </input>
        <input name="UADayZBRSpectateMode">
            <btn name="kF5" />
        </input>
        <input name="UADayZBRSpectateNext">
            <btn name="kRight" />
        </input>
        <input name="UADayZBRSpectatePrev">
            <btn name="kLeft" />
        </input>
        <!-- Skeleton overlay. F6 is the next free function key after F5, and it is bound to nothing
             in vanilla or in Community-Online-Tools (checked: no kF6 appears in COT's Inputs.xml at
             all). Client-side only - it flips COT's own ESP skeleton renderer, which is why there is
             no server RPC behind this one and no server-side refusal to match. -->
        <input name="UADayZBRSpectateSkeleton">
            <btn name="kF6" />
        </input>
        <!-- First / third person while spectating. Space is vanilla's vault key, which is free here
             for the one reason that matters: a spectator controls no character, so there is nothing
             for a vault to act on, and the admin free camera does not read it either. Unlike the five
             above, this one is NOT admin-only and has no server half - it changes where this client's
             own camera sits and nothing else. -->
        <input name="UADayZBRSpectateView">
            <btn name="kSpace" />
        </input>
    </preset>
</modded_inputs>
