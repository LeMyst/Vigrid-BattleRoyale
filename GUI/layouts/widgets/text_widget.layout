   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   text "Text"
   font "gui/fonts/sdf_MetronBook24"
   "exact text" 1
   "size to text h" 1
   "size to text v" 1
   "text halign" center
   "text valign" center
   priority 2000
  }
 }
}