// One row of the Last Match standings. Column x positions are 8px inside the header positions in
// leaderboard.layout, matching how leaderboard_row.layout sits under its own headers.
//
// The root's alpha is raised from script for the viewing player's own row - a separate "highlight"
// layout would be a second thing to keep in step with this one.
PanelWidgetClass SummaryRowRoot {
 visible 1
 position 0 0
 size 820 26
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 color 1 1 1 0.16
 style DayZDefaultPanel
 {
  TextWidgetClass RowPlace {
   position 8 0
   size 60 26
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text "1"
   font "gui/fonts/metron"
   "exact text" 0
   "text halign" left
   "text valign" center
  }
  TextWidgetClass RowName {
   position 76 0
   size 300 26
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text "Survivor"
   font "gui/fonts/metron"
   "exact text" 0
   "text halign" left
   "text valign" center
  }
  TextWidgetClass RowKills {
   position 388 0
   size 100 26
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text "0"
   font "gui/fonts/metron"
   "exact text" 0
   "text halign" center
   "text valign" center
  }
  TextWidgetClass RowDamage {
   position 496 0
   size 120 26
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text "0"
   font "gui/fonts/metron"
   "exact text" 0
   "text halign" center
   "text valign" center
  }
  TextWidgetClass RowSurvived {
   position 626 0
   size 186 26
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style Bold
   text "0:00"
   font "gui/fonts/metron"
   "exact text" 0
   "text halign" right
   "text valign" center
  }
 }
}
