PanelWidgetClass LeaderboardRoot {
 position 0 0
 size 1 1
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 color 0 0 0 0.69
 style DayZDefaultPanel
 {
  PanelWidgetClass Dialog {
   position 0 0
   // 840 rather than 700: the Last Match tab needs a card above its table. The ladder tab uses the
   // extra height for a taller scroll rather than leaving a gap.
   size 920 840
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 0.102 0.102 0.102 0.94
   style DayZDefaultPanel
   {
    TextWidgetClass Title {
     position 24 16
     size 520 40
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Bold
     text "#STR_BR_LEADERBOARD_TITLE"
     font "gui/fonts/metron"
     "exact text" 0
     "text halign" left
     "text valign" center
    }
    TextWidgetClass SeasonText {
     position 560 16
     size 336 40
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     text ""
     font "gui/fonts/metron"
     "exact text" 0
     "text halign" right
     "text valign" center
    }
    ButtonWidgetClass SoloTabButton {
     position 24 64
     size 160 36
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Editor
     text "#STR_BR_LEADERBOARD_SOLO"
     text_proportion 0.6
     font "gui/fonts/metron"
    }
    ButtonWidgetClass GroupTabButton {
     position 192 64
     size 160 36
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Editor
     text "#STR_BR_LEADERBOARD_GROUP"
     text_proportion 0.6
     font "gui/fonts/metron"
    }
    // The third tab is not a ladder at all - it is the PREVIOUS match, read back from
    // last_match.json by this server process. It shares this menu and nothing else: its own request
    // RPC, its own client cache and its own sequence counter.
    ButtonWidgetClass LastMatchTabButton {
     position 360 64
     size 160 36
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Editor
     text "#STR_BR_LASTMATCH_TAB"
     text_proportion 0.6
     font "gui/fonts/metron"
    }
    PanelWidgetClass SoloTabAccent {
     visible 1
     position 24 100
     size 160 4
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 0.85 0.62 0.16 1
     style DayZDefaultPanel
    }
    PanelWidgetClass GroupTabAccent {
     visible 0
     position 192 100
     size 160 4
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 0.85 0.62 0.16 1
     style DayZDefaultPanel
    }
    PanelWidgetClass LastMatchTabAccent {
     visible 0
     position 360 100
     size 160 4
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 0.85 0.62 0.16 1
     style DayZDefaultPanel
    }

    // ---------------------------------------------------------------------------------------
    // Two grouping containers, swapped by the tab. Both sit at 0,0 at the dialog's full size, so
    // every child keeps the exact coordinates it would have had as a direct child of Dialog and
    // nothing has to be repositioned from script - which matters, because DECLARED geometry is
    // scaled by viewport/1920 while SetPos takes real pixels, and mixing the two shifts a whole
    // group while its spacing stays correct.
    //
    // Neither container carries a `style` line, and that is what makes them free: a PanelWidget
    // with no style paints nothing at all, so these are pure grouping nodes. They must NOT be
    // transparent either - widget alpha multiplies through parents, so `color 0 0 0 0` here would
    // make every inheritalpha child invisible with a completely clean .rpt.
    // ---------------------------------------------------------------------------------------

    PanelWidgetClass LadderPanel {
     visible 1
     position 0 0
     size 920 840
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 1 1 1 1
     {
