    TextWidgetClass StatusText {
     ignorepointer 1
     inheritalpha 0
     position 0 488
     size 1200 30
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 0.608 0.631 0.651 1
