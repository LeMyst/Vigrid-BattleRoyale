FrameWidgetClass BattleRoyaleHudFrame {
 ignorepointer 1
 position 0 0
 size 1 1
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass HudPanel {
   ignorepointer 1
   position 0 0
   size 0.9 0.9
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   {
    GridSpacerWidgetClass MatchInfoIconsPanel {
     ignorepointer 1
     size 202 163.75
     halign right_ref
     hexactpos 0
     vexactpos 0
     hexactsize 1
     vexactsize 1
     Columns 1
     Rows 5
     {
      GridSpacerWidgetClass PlayersPanel {
       ignorepointer 1
       clipchildren 1
       size 48 48
       halign right_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       "Ignore invisible" 0
       content_halign right
       Columns 2
       Rows 1
       {
        PanelWidgetClass GroupsCountPanel {
         ignorepointer 1
         position 0 0
         size 202 32
         halign right_ref
         hexactpos 0
         vexactpos 0
         hexactsize 1
         vexactsize 1
         {
          ImageWidgetClass GroupIcon {
           ignorepointer 1
           position 0 0
           size 32 32
           halign right_ref
           hexactpos 0
           vexactpos 0
           hexactsize 1
           vexactsize 1
             // Ours, in the mod's own atlas - vanilla has no group glyph. Composited from two
             // copies of vanilla's icon_player at Pos 0 256 of dayzbr_gui.edds; see the imageset.
             image0 "set:battleroyale_gui image:GroupIcon"
           mode blend
           "src alpha" 1
           "no wrap" 1
           stretch 1
          }
          TextWidgetClass GroupText {
           ignorepointer 1
           position 0.425 0
           size 55 32
           halign right_ref
           hexactpos 0
           vexactpos 0
           hexactsize 1
           vexactsize 1
           style Bold
           text "14"
           font "gui/fonts/etelkatextpro"
           "exact text" 0
           "size to text h" 0
           "size to text v" 0
           "text halign" right
           "text valign" center
          }
         }
        }
        PanelWidgetClass PlayerCountPanel {
         ignorepointer 1
         size 202 32
         hexactpos 0
         vexactpos 0
         hexactsize 1
         vexactsize 1
         {
          ImageWidgetClass PlayerIcon {
           ignorepointer 1
           position 0 0
           size 32 32
           halign right_ref
           hexactpos 0
           vexactpos 0
           hexactsize 1
           vexactsize 1
           image0 "set:dayz_gui image:icon_player"
           mode blend
           "src alpha" 1
           "no wrap" 1
           stretch 1
          }
          TextWidgetClass PlayerText {
           ignorepointer 1
           position 0.425 0
           size 55 32
           halign right_ref
           hexactpos 0
           vexactpos 0
           hexactsize 1
           vexactsize 1
           style Bold
           text "47"
           font "gui/fonts/etelkatextpro"
           "exact text" 0
           "size to text h" 0
           "size to text v" 0
           "text halign" right
           "text valign" center
          }
         }
        }
       }
      }
      PanelWidgetClass KillCountPanel {
       visible 1
       ignorepointer 1
       position 0 99
       size 202 32
       halign right_ref
       hexactpos 0
       vexactpos 1
       hexactsize 1
       vexactsize 1
       {
        ImageWidgetClass KillIcon {
         ignorepointer 1
         position 0 0
         size 32 32
         halign right_ref
         hexactpos 0
         vexactpos 0
         hexactsize 1
         vexactsize 1
         image0 "set:dayz_gui image:iconSkull"
         mode blend
         "src alpha" 1
         "no wrap" 1
         stretch 1
        }
        TextWidgetClass KillCountText {
         ignorepointer 1
         position 42 0
         size 150 32
         halign right_ref
         hexactpos 1
         vexactpos 0
         hexactsize 1
         vexactsize 1
         style Bold
         text "99"
         font "gui/fonts/etelkatextpro"
         "exact text" 0
         "text halign" right
         "text valign" center
        }
       }
      }
      PanelWidgetClass CountdownPanel {
       visible 1
       ignorepointer 1
       position 0 66
       size 202 32
       halign right_ref
       hexactpos 0
       vexactpos 1
       hexactsize 1
       vexactsize 1
       {
        ImageWidgetClass CountdownIcon {
         position 0 0
         size 32 32
         halign right_ref
         hexactpos 0
         vexactpos 0
         hexactsize 1
         vexactsize 1
         // Ours. Vanilla's ccgui_enforce IconTime is a 16px source and this widget draws at 32 -
         // more on a wide screen, since a declared size is viewport-scaled - so it was being
         // upscaled 2-3x and the hands turned to mush. Drawn at 64 so the HUD only downsamples.
         //
         // Two alternates sit beside it in the atlas - swap the name and nothing else:
         //   ClockSimple  ring + two hands (in use)
         //   ClockTicks   also marks at 12/3/6/9, busier
         //   ClockSolid   filled disc with the hands knocked out, heaviest
         image0 "set:battleroyale_gui image:ClockSimple"
         mode blend
         "src alpha" 1
         "no wrap" 1
         stretch 1
        }
        TextWidgetClass CountdownText {
         ignorepointer 1
         position 42 -0.01
         size 150 31
         halign right_ref
         hexactpos 1
         vexactpos 0
         hexactsize 1
         vexactsize 1
         style Bold
         text "10:58"
         font "gui/fonts/etelkatextpro"
         "exact text" 0
         "text halign" right
         "text valign" center
        }
       }
      }
      PanelWidgetClass ZoneDistancePanel {
       ignorepointer 1
       position 0 33
       size 202 32
       halign right_ref
       hexactpos 0
       vexactpos 1
       hexactsize 1
       vexactsize 1
       {
        ImageWidgetClass ZoneIcon {
         ignorepointer 1
         position 0 0
         size 32 32
         halign right_ref
         hexactpos 0
         vexactpos 0
         hexactsize 1
         vexactsize 1
         // RESTS POINTING UP, which is what BattleRoyaleHud.SetDistance's SetRotation(0,0,angle)
         // already assumes. Vanilla's icon_arrow rested pointing DOWN and so aimed 180 degrees
         // out; it also read as a plain triangle, and at 45 or 135 degrees of rotation became an
         // unreadable blob. All four of ours are drawn resting up, so swapping needs no code change.
         //
         // Three alternates sit beside this one in the atlas - swap the name and nothing else:
         //   ZoneArrowNeedle   slim compass needle (in use)
         //   ZoneArrowDart     notched dart. the map already uses this silhouette for YOU
         //   ZoneArrowClassic  head on a stem, the heaviest
         //   ZoneArrowChevron  open chevron, weakest when rotated - reads as an L
         image0 "set:battleroyale_gui image:ZoneArrowNeedle"
         mode blend
         "src alpha" 1
         "no wrap" 1
         stretch 1
        }
        TextWidgetClass DistanceText {
         ignorepointer 1
         position 42 0
         size 150 32
         halign right_ref
         hexactpos 1
         vexactpos 0
         hexactsize 1
         vexactsize 1
         style Bold
         text "#STR_BR_SAFE"
         font "gui/fonts/etelkatextpro"
         "exact text" 0
         "text halign" right
         "text valign" center
        }
       }
      }
      PanelWidgetClass AudienceCountPanel {
       visible 1
       ignorepointer 1
       position 0 99
       size 202 32
       halign right_ref
       hexactpos 0
       vexactpos 1
       hexactsize 1
       vexactsize 1
       {
        ImageWidgetClass AudienceIcon {
         ignorepointer 1
         position 0 0
         size 32 32
         halign right_ref
         hexactpos 0
         vexactpos 0
         hexactsize 1
         vexactsize 1
         image0 "set:dayz_gui image:PasswordEyeOpen"
         mode blend
         "src alpha" 1
         "no wrap" 1
         stretch 1
        }
        TextWidgetClass AudienceText {
         ignorepointer 1
         position 42 0
         size 150 32
         halign right_ref
         hexactpos 1
         vexactpos 0
         hexactsize 1
         vexactsize 1
         style Bold
         text "3"
         font "gui/fonts/etelkatextpro"
         "exact text" 0
         "text halign" right
         "text valign" center
        }
       }
      }
     }
    }
   }
  }
 }
}
