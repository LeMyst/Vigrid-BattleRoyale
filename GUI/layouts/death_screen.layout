PanelWidgetClass DeathRoot {
 keepsafezone 0
 position -0.02 -0.02
 size 1.04 1.04
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 priority 900
 color 0.157 0.008 0.008 1
 style DayZDefaultPanel
 {
  PanelWidgetClass Dialog {
   inheritalpha 0
   position 0 0
   size 1000 340
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 0 0 0 0
   {
    TextWidgetClass PlacementText {
     inheritalpha 0
     position 0 0
     size 1000 52
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 1 1 1 1
     style Bold
     text ""
     font "gui/fonts/metron"
     "exact text" 0
     "text halign" center
     "text valign" center
    }
    MultilineTextWidgetClass FlavourText {
     inheritalpha 0
     position 0 60
     size 1000 80
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 0.85 0.85 0.85 1
     text ""
     font "gui/fonts/metron"
     "exact text" 0
     "size to text h" 0
     "size to text v" 0
     "text halign" center
     "text valign" center
     wrap 1
    }
    TextWidgetClass StatusText {
     inheritalpha 0
     position 0 152
     size 1000 32
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 0.75 0.75 0.75 1
     text ""
     font "gui/fonts/metron"
     "exact text" 0
     "text halign" center
     "text valign" center
    }
    ButtonWidgetClass SpectateButton {
     inheritalpha 0
     position 140 220
     size 220 48
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Editor
     text "#STR_BR_DEAD_SPECTATE"
     text_proportion 0.6
     font "gui/fonts/metron"
    }
    // Admin only, and hidden unless BattleRoyaleRPC.is_admin says so. Sends the same
    // AdminSpectateToggle the F3 key does - the server reads that as "respawn, then spectate",
    // because this player is dead. Three 220px buttons at 140/390/640 fit the 1000px dialog, which
    // is why the two originals moved off 260/520.
    ButtonWidgetClass AdminButton {
     inheritalpha 0
     position 390 220
     size 220 48
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Editor
     text "#STR_BR_DEAD_ADMIN"
     text_proportion 0.6
     font "gui/fonts/metron"
    }
    ButtonWidgetClass QuitButton {
     inheritalpha 0
     position 640 220
     size 220 48
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Editor
     text "#STR_BR_DEAD_QUIT"
     text_proportion 0.6
     font "gui/fonts/metron"
    }
   }
  }
 }
}
