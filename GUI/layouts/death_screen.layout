PanelWidgetClass DeathRoot {
 keepsafezone 0
 position -0.02 -0.02
 size 1.04 1.04
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 priority 900
 color 0.157 0.008 0.008 1
 style DayZDefaultPanel
 {
  PanelWidgetClass Dialog {
   inheritalpha 0
   position 0 0
   // 404 rather than 340: the recap block below adds 64px. Dialog is center_ref, so growing it
   // re-centres itself and DeathRoot is untouched.
   size 1000 404
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 0 0 0 0
   {
    TextWidgetClass PlacementText {
     inheritalpha 0
     position 0 0
     size 1000 52
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 1 1 1 1
     style Bold
     text ""
     font "gui/fonts/metron"
     "exact text" 0
     "text halign" center
     "text valign" center
    }
    MultilineTextWidgetClass FlavourText {
     inheritalpha 0
     position 0 60
     size 1000 80
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 0.85 0.85 0.85 1
     text ""
     font "gui/fonts/metron"
     "exact text" 0
     "size to text h" 0
     "size to text v" 0
     "text halign" center
     "text valign" center
     wrap 1
    }
    // Who killed you, with what, at what range - plus how they were left and what you had already
    // taken off them. Painted from DeathScreenMenu.Tick(), NOT from Init(): the recap is pushed by
    // the server while the menu is opened locally the instant the death command starts, so it is
    // structurally late, not merely occasionally late.
    // Empty when there is nothing to say. Dialog is fully transparent, so an empty widget here
    // leaves no visible gap and nothing has to be repositioned at runtime.
    MultilineTextWidgetClass RecapText {
     inheritalpha 0
     position 0 146
     size 1000 56
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 0.85 0.78 0.62 1
     text ""
     font "gui/fonts/metron"
     "exact text" 0
     "size to text h" 0
     "size to text v" 0
     "text halign" center
     "text valign" center
     wrap 1
    }
    TextWidgetClass StatusText {
     inheritalpha 0
     position 0 216
     size 1000 32
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 0.75 0.75 0.75 1
     text ""
     font "gui/fonts/metron"
     "exact text" 0
     "text halign" center
     "text valign" center
    }
    ButtonWidgetClass SpectateButton {
     inheritalpha 0
     position 140 284
     size 220 48
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Editor
     text "#STR_BR_DEAD_SPECTATE"
     text_proportion 0.6
     font "gui/fonts/metron"
    }
    // Admin only, and hidden unless BattleRoyaleRPC.is_admin says so. Sends the same
    // AdminSpectateToggle the F3 key does - the server reads that as "respawn, then spectate",
    // because this player is dead. Three 220px buttons at 140/390/640 fit the 1000px dialog, which
    // is why the two originals moved off 260/520.
    ButtonWidgetClass AdminButton {
     inheritalpha 0
     position 390 284
     size 220 48
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Editor
     text "#STR_BR_DEAD_ADMIN"
     text_proportion 0.6
     font "gui/fonts/metron"
    }
    ButtonWidgetClass QuitButton {
     inheritalpha 0
     position 640 284
     size 220 48
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Editor
     text "#STR_BR_DEAD_QUIT"
     text_proportion 0.6
     font "gui/fonts/metron"
    }
   }
  }
 }
}
